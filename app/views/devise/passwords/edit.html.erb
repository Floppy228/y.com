<% content_for :title, "Смена пароля | Y.com" %>

<div class="flex min-h-screen items-center justify-center bg-black px-4">
  <div class="w-full max-w-md rounded-3xl border border-zinc-900 bg-zinc-950 p-8 shadow-2xl">
    <div class="mb-8 text-center">
      <h1 class="mb-2 text-3xl font-black text-white">
        Новый пароль
      </h1>
      <p class="text-sm text-zinc-500">
        Придумайте новый пароль для вашего аккаунта
      </p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, novalidate: true }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="mb-4">
        <%= f.label :password, "Новый пароль", class: "mb-1 block text-xs font-semibold tracking-wide text-zinc-500" %>
        <div class="relative flex items-center">
          <svg class="pointer-events-none absolute left-3 h-[18px] w-[18px] text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          <%= f.password_field :password,
                id: "newPassword",
                autofocus: true,
                autocomplete: "new-password",
                placeholder: "••••••••",
                class: "w-full rounded-xl border border-zinc-800 bg-black py-3 pl-11 pr-11 text-sm text-white outline-none transition placeholder:text-zinc-600 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/20" %>
          <button class="absolute right-3 text-zinc-500 transition hover:scale-110 hover:text-indigo-500" type="button" data-password-toggle="newPassword" aria-label="Показать пароль" aria-pressed="false">
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
        <% if @minimum_password_length %>
          <p class="mt-1.5 text-xs text-zinc-600">Минимум <%= @minimum_password_length %> символов</p>
        <% end %>
      </div>

      <div class="mb-6">
        <%= f.label :password_confirmation, "Подтвердите пароль", class: "mb-1 block text-xs font-semibold tracking-wide text-zinc-500" %>
        <div class="relative flex items-center">
          <svg class="pointer-events-none absolute left-3 h-[18px] w-[18px] text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          <%= f.password_field :password_confirmation,
                autocomplete: "new-password",
                placeholder: "••••••••",
                class: "w-full rounded-xl border border-zinc-800 bg-black py-3 pl-11 pr-3 text-sm text-white outline-none transition placeholder:text-zinc-600 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/20" %>
        </div>
      </div>

      <button class="group mb-4 flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-500 p-3 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-indigo-600 hover:shadow-lg hover:shadow-indigo-500/30" type="submit">
        <span>Сменить пароль</span>
        <svg class="h-[18px] w-[18px] transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14"/>
          <path d="M12 5l7 7-7 7"/>
        </svg>
      </button>
    <% end %>

    <div class="mt-6 flex items-center justify-center gap-4 text-sm">
      <%= link_to "Войти", auth_path(auth_mode: "login"), class: "font-semibold text-indigo-500 transition hover:text-indigo-400" %>
      <span class="text-zinc-700">|</span>
      <%= link_to "Регистрация", auth_path(auth_mode: "register"), class: "font-semibold text-indigo-500 transition hover:text-indigo-400" %>
    </div>
  </div>
</div>