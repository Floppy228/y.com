<div class="flex min-h-screen items-center justify-center bg-black px-4">
  <div class="w-full max-w-md rounded-3xl border border-zinc-900 bg-zinc-950 p-8 shadow-2xl">
    <div class="mb-8 text-center">
      <h1 class="mb-2 text-4xl font-black text-white">
        Восстановление
      </h1>

      <p class="text-zinc-500">
        Введите email для сброса пароля
      </p>
    </div>

    <%= form_for(resource,
          as: resource_name,
          url: account_restore_send_path,
          html: { method: :post }) do |f| %>

      <div class="mb-5">
        <%= f.label :email, class: "mb-2 block text-sm font-medium text-zinc-400" %>

        <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "w-full rounded-xl border border-zinc-800 bg-black px-4 py-3 text-white outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/20" %>
      </div>

      <%= f.submit "Отправить инструкции",
            class: "w-full cursor-pointer rounded-xl bg-indigo-500 py-3 font-bold text-white transition hover:bg-indigo-600" %>
    <% end %>

    <div class="mt-6 text-center">
      <%= link_to "Назад ко входу",
            auth_path(auth_mode: "login"),
            class: "text-sm text-zinc-500 transition hover:text-white" %>
    </div>
  </div>
</div>
