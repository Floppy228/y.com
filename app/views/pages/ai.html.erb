<% content_for :title, "Y-Core | Y.com" %>

<div class="fixed inset-0 mx-auto grid h-screen w-full max-w-[1400px] overflow-hidden bg-black text-white" style="grid-template-columns: 280px minmax(0, 1fr) 320px;">
  <aside class="h-screen overflow-y-auto border-r border-zinc-900 bg-black px-4 py-5">
    <%= link_to "Y.com", root_path, class: "mb-8 inline-block bg-gradient-to-br from-white to-indigo-500 bg-clip-text pl-3 text-[42px] font-black tracking-[-1.5px] text-transparent" %>

    <nav class="flex flex-col gap-1">
      <%= link_to root_path, class: "flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white" do %>
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Главная
      <% end %>

      <%= link_to "/profile", class: "flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white" do %>
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        Профиль
      <% end %>

      <%= link_to "/messages", class: "flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white" do %>
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        Сообщения
      <% end %>

      <%= link_to "/ai", class: "flex items-center gap-4 rounded-full bg-zinc-950 px-4 py-3 text-lg font-semibold text-white" do %>
        <svg class="h-6 w-6 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 8v8M8 12h8"/>
        </svg>
        Y-Core
      <% end %>

      <%= link_to "/following", class: "flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white" do %>
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        Подписки
      <% end %>

      <%= link_to "/settings", class: "flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white" do %>
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H5.78a1.65 1.65 0 0 0-1.51 1 1.65 1.65 0 0 0 .33 1.82l.07.08A10 10 0 0 0 12 17.66a10 10 0 0 0 6.26-2.58z"/>
          <path d="M16.5 6.5L19 9l-2.5 2.5"/>
          <path d="M7.5 6.5L5 9l2.5 2.5"/>
        </svg>
        Настройки
      <% end %>
    </nav>

    <% if user_signed_in? %>
      <%= button_to destroy_user_session_path, method: :delete, class: "mt-8 flex w-full items-center justify-center gap-2 rounded-full bg-indigo-500 px-6 py-3.5 text-base font-bold text-white transition hover:-translate-y-0.5 hover:bg-indigo-600 hover:shadow-lg hover:shadow-indigo-500/30" do %>
        Выйти
      <% end %>
    <% end %>
  </aside>

  <main class="h-screen overflow-hidden border-r border-zinc-900 bg-black">
    <div class="flex h-full flex-col">
      <div class="sticky top-0 z-30 border-b border-zinc-900 bg-black/95 px-6 py-4 backdrop-blur">
        <h1 class="text-[22px] font-bold text-white">Y-Core</h1>
      </div>

      <section class="flex-1 overflow-y-auto px-6 py-6">
        <div class="mb-6 rounded-[24px] border border-zinc-900 bg-zinc-950 p-6">
          <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-purple-950 text-2xl font-black text-white">Y</div>
            <div>
              <h2 class="text-2xl font-bold text-white">Чем могу помочь?</h2>
              <p class="mt-1 text-sm text-zinc-500">Y-Core помогает писать посты, объяснять идеи и планировать проект.</p>
            </div>
          </div>
        </div>

        <div class="mt-6 space-y-5">
          <div class="flex gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-purple-950 text-sm font-bold text-white">Y</div>
            <div class="max-w-[75%] rounded-2xl border border-zinc-900 bg-zinc-950 px-5 py-4 text-sm leading-relaxed text-zinc-200">Привет! Я Y-Core. Задай вопрос, и я помогу с текстом, идеей или планом.</div>
          </div>

          <div class="flex justify-end gap-3">
            <div class="max-w-[75%] rounded-2xl border border-indigo-500/30 bg-indigo-500/10 px-5 py-4 text-sm leading-relaxed text-zinc-100">Например: помоги написать пост о новом проекте.</div>
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-zinc-900 text-sm font-bold text-white">Я</div>
          </div>
        </div>
      </section>

      <div class="border-t border-zinc-900 bg-black px-6 py-5">
        <form class="rounded-[20px] border border-zinc-900 bg-zinc-950 p-4 transition focus-within:border-indigo-500 focus-within:ring-4 focus-within:ring-indigo-500/20">
          <textarea rows="2" placeholder="Спросите Y-Core..." class="min-h-[54px] w-full resize-none bg-transparent text-[17px] leading-relaxed text-white outline-none placeholder:text-zinc-500"></textarea>

          <div class="mt-3 flex items-center justify-between border-t border-zinc-900 pt-3">
            <div class="flex gap-2">
              <button type="button" class="flex h-[38px] w-[38px] items-center justify-center rounded-full border border-zinc-900 text-zinc-500 transition hover:border-indigo-500 hover:bg-zinc-900 hover:text-indigo-500">+</button>
              <button type="button" class="flex h-[38px] w-[38px] items-center justify-center rounded-full border border-zinc-900 text-zinc-500 transition hover:border-indigo-500 hover:bg-zinc-900 hover:text-indigo-500">$</button>
            </div>

            <button type="submit" class="rounded-full bg-indigo-500 px-6 py-2 text-sm font-semibold text-white transition hover:bg-indigo-600">Отправить</button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <aside class="h-screen overflow-y-auto bg-black p-5">
    <input type="text" placeholder="Поиск" class="w-full rounded-full border border-zinc-900 bg-zinc-950 px-5 py-3 text-[15px] text-white outline-none transition placeholder:text-zinc-500 focus:border-indigo-500">

    <div class="mt-6 rounded-2xl border border-zinc-900 bg-zinc-950 p-5">
      <h3 class="mb-4 text-lg font-semibold text-white">Возможности</h3>
      <div class="space-y-3">
        <% [["Быстрые ответы", "Ответы на вопросы по проекту"], ["Помощь с постами", "Идеи и тексты для публикаций"], ["Объяснение сложного", "Простыми словами для новичка"], ["Планирование", "Шаги для разработки"]].each do |title, text| %>
          <div class="rounded-xl border border-zinc-900 bg-black px-4 py-3">
            <div class="text-sm font-semibold text-white"><%= title %></div>
            <div class="mt-1 text-xs text-zinc-500"><%= text %></div>
          </div>
        <% end %>
      </div>
    </div>
  </aside>
</div>
