<div class="fixed inset-0 mx-auto grid h-screen w-full max-w-[1400px] grid-cols-[280px_1fr_320px] overflow-hidden bg-black text-white">
  <aside class="h-screen overflow-y-auto border-r border-zinc-900 bg-black px-4 py-5">
    <a href="/" class="mb-8 inline-block bg-gradient-to-br from-white to-indigo-500 bg-clip-text pl-3 text-[42px] font-black tracking-[-1.5px] text-transparent">
      Y.com
    </a>

    <nav class="flex flex-col gap-1">
      <a href="/" class="flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white">
        <span>🏠</span>
        Главная
      </a>

      <a href="/profile" class="flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white">
        <span>👤</span>
        Профиль
      </a>

      <a href="/messages" class="flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white">
        <span>✉️</span>
        Сообщения
      </a>

      <a href="/ai" class="flex items-center gap-4 rounded-full bg-zinc-950 px-4 py-3 text-lg font-semibold text-white">
        <span class="text-indigo-500">✦</span>
        Y-Core
      </a>

      <a href="/following" class="flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white">
        <span>👥</span>
        Подписки
      </a>

      <a href="/settings" class="flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white">
        <span>⚙️</span>
        Настройки
      </a>
    </nav>

    <% if user_signed_in? %>
      <%= button_to destroy_user_session_path, method: :delete, class: "mt-8 flex w-full items-center justify-center gap-2 rounded-full bg-indigo-500 px-6 py-3.5 text-base font-bold text-white transition hover:-translate-y-0.5 hover:bg-indigo-600 hover:shadow-lg hover:shadow-indigo-500/30" do %>
        Выйти
      <% end %>
    <% end %>
  </aside>

  <main class="h-screen overflow-hidden border-r border-zinc-900 bg-black">
    <div class="flex h-full flex-col">
      <div class="border-b border-zinc-900 bg-black/95 px-6 py-4 backdrop-blur">
        <h1 class="text-[22px] font-bold text-white">Y-Core</h1>
      </div>

      <section class="flex flex-1 flex-col justify-center overflow-y-auto px-10">
        <div class="mx-auto w-full max-w-[900px]">
          <div class="mb-12 text-center">
            <div class="mb-5 bg-gradient-to-br from-white to-indigo-500 bg-clip-text text-7xl font-black text-transparent drop-shadow-[0_0_30px_rgba(99,102,241,0.3)]">
              Y
            </div>

            <h2 class="mb-8 bg-gradient-to-br from-white to-indigo-300 bg-clip-text text-4xl font-bold tracking-tight text-transparent">
              Чем могу помочь?
            </h2>

            <div class="flex flex-wrap justify-center gap-3">
              <% ["Помоги написать пост", "Объясни идею проще", "Придумай описание профиля", "Составь план проекта"].each do |text| %>
                <button class="rounded-full border border-zinc-800 bg-zinc-950 px-6 py-3 text-sm font-medium text-zinc-500 transition hover:-translate-y-0.5 hover:border-indigo-500 hover:bg-indigo-500 hover:text-white hover:shadow-lg hover:shadow-indigo-500/20">
                  <%= text %>
                </button>
              <% end %>
            </div>
          </div>

          <div class="mb-8 hidden">
            <div class="mb-8">
              <div class="mb-3 flex items-center gap-3 text-lg font-semibold text-white">
                <div class="h-8 w-8 rounded-full bg-gradient-to-br from-indigo-500 to-purple-950"></div>
                Пользователь
              </div>

              <div class="ml-10 rounded-3xl border border-zinc-900 bg-zinc-950 px-6 py-5 text-[17px] leading-relaxed text-zinc-200">
                Пример вопроса пользователя.
              </div>
            </div>

            <div class="mb-8">
              <div class="ml-10 rounded-3xl border border-zinc-900 bg-zinc-950 px-6 py-5 text-[17px] leading-relaxed text-zinc-200">
                Я могу помочь с текстами, идеями, объяснениями и планированием проекта.
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="px-10 pb-8">
        <form class="mx-auto w-full max-w-[900px]">
          <div class="rounded-[28px] border border-zinc-800 bg-zinc-950 px-6 py-4 shadow-2xl transition focus-within:border-indigo-500 focus-within:ring-4 focus-within:ring-indigo-500/20">
            <textarea rows="2" placeholder="Спросите Y-Core..." class="min-h-[30px] max-h-[200px] w-full resize-none bg-transparent text-lg leading-relaxed text-white outline-none placeholder:text-zinc-500"></textarea>

            <div class="mt-4 flex items-center justify-between border-t border-zinc-900 pt-4">
              <div class="flex gap-2">
                <button type="button" class="flex h-10 w-10 items-center justify-center rounded-full text-zinc-500 transition hover:bg-zinc-900 hover:text-indigo-500">
                  +
                </button>

                <button type="button" class="flex h-10 w-10 items-center justify-center rounded-full text-zinc-500 transition hover:bg-zinc-900 hover:text-indigo-500">
                  🎤
                </button>
              </div>

              <button type="submit" class="flex h-12 w-12 items-center justify-center rounded-full bg-indigo-500 text-xl text-white transition hover:scale-105 hover:bg-indigo-600 hover:shadow-lg hover:shadow-indigo-500/30">
                ➜
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </main>

  <aside class="h-screen overflow-y-auto bg-black p-5">
    <input type="text" placeholder="Поиск" class="w-full rounded-full border border-zinc-900 bg-zinc-950 px-5 py-3 text-[15px] text-white outline-none placeholder:text-zinc-500 focus:border-indigo-500">

    <div class="mt-6 rounded-2xl border border-zinc-900 bg-zinc-950 p-5">
      <h3 class="mb-4 text-lg font-semibold text-white">Возможности</h3>

      <% [
        ["⚡", "Быстрые ответы"],
        ["✍️", "Помощь с постами"],
        ["🧠", "Объяснение сложного"],
        ["📌", "Планирование задач"]
      ].each do |icon, text| %>
        <div class="flex items-center gap-3 border-b border-zinc-900 py-3 last:border-b-0">
          <span class="text-indigo-500"><%= icon %></span>
          <span class="text-sm text-zinc-200"><%= text %></span>
        </div>
      <% end %>
    </div>

    <div class="mt-6 rounded-2xl border border-zinc-900 bg-zinc-950 p-5">
      <h3 class="mb-4 text-lg font-semibold text-white">Актуальное</h3>

      <div class="mt-4 cursor-pointer group">
        <span class="text-sm text-zinc-500">#YCore</span>
        <div class="mt-1 font-semibold text-white transition group-hover:text-indigo-500">AI-помощник</div>
      </div>

      <div class="mt-4 cursor-pointer group">
        <span class="text-sm text-zinc-500">#Ycom</span>
        <div class="mt-1 font-semibold text-white transition group-hover:text-indigo-500">Новая версия</div>
      </div>
    </div>
  </aside>
</div>