<% content_for :title, "Подписки | Y.com" %>

<%
  page_name = current_user&.name.presence || current_user&.username.presence || "Пользователь"

  following_users = [
    {
      name: "Елена Владимирова",
      handle: "@elena_design",
      bio: "UX/UI дизайнер. Делаю интерфейсы понятными, красивыми и удобными.",
      posts: 248,
      followers: "12.4K",
      online: true,
      verified: true,
      avatar_class: "from-indigo-500 to-purple-950"
    },
    {
      name: "Дмитрий Волков",
      handle: "@dmitry_dev",
      bio: "Ruby on Rails разработчик. Пишу про backend, базы данных и pet-проекты.",
      posts: 391,
      followers: "8.1K",
      online: false,
      verified: false,
      avatar_class: "from-zinc-700 to-black"
    },
    {
      name: "Анна Смирнова",
      handle: "@anna_ai",
      bio: "AI, нейросети, продукты и автоматизация рабочих процессов.",
      posts: 532,
      followers: "24.7K",
      online: true,
      verified: true,
      avatar_class: "from-indigo-500 to-slate-950"
    }
  ]

  followers_users = [
    {
      name: "Максим Орлов",
      handle: "@max_orlov",
      bio: "Frontend developer. Люблю TailwindCSS, Rails и чистый UI.",
      posts: 127,
      followers: "3.2K",
      online: false,
      verified: false,
      avatar_class: "from-zinc-700 to-zinc-950"
    },
    {
      name: "София Крылова",
      handle: "@sofia_code",
      bio: "Учусь программировать и собираю свой первый большой проект.",
      posts: 84,
      followers: "940",
      online: true,
      verified: false,
      avatar_class: "from-indigo-500 to-purple-950"
    }
  ]

  recommended_users = [
    {
      name: "Илья Романов",
      handle: "@ilya_product",
      bio: "Product manager. Пишу про запуск проектов и развитие стартапов.",
      posts: 315,
      followers: "18.5K",
      online: false,
      verified: true,
      avatar_class: "from-indigo-500 to-purple-950"
    },
    {
      name: "Мария Белова",
      handle: "@maria_design",
      bio: "Графический дизайнер. Цвет, композиция, брендинг и визуальные системы.",
      posts: 202,
      followers: "6.8K",
      online: true,
      verified: false,
      avatar_class: "from-zinc-700 to-black"
    }
  ]
%>

<div class="fixed inset-0 mx-auto grid h-screen w-full max-w-[1400px] overflow-hidden bg-black text-white" style="grid-template-columns: 280px minmax(0, 1fr) 320px;">

  <!-- LEFT SIDEBAR -->
  <aside class="h-screen overflow-y-auto border-r border-zinc-900 bg-black px-4 py-5">
    <%= link_to "Y.com", root_path, class: "mb-8 inline-block bg-gradient-to-br from-white to-indigo-500 bg-clip-text pl-3 text-[42px] font-black tracking-[-1.5px] text-transparent" %>

    <nav class="flex flex-col gap-1">
      <%= link_to root_path, class: "flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white" do %>
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Главная
      <% end %>

      <%= link_to "/profile", class: "flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white" do %>
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        Профиль
      <% end %>

      <%= link_to "/messages", class: "flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white" do %>
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        Сообщения
      <% end %>

      <%= link_to "/ai", class: "flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white" do %>
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 8v8M8 12h8"/>
        </svg>
        Y-Core
      <% end %>

      <%= link_to "/following", class: "flex items-center gap-4 rounded-full bg-zinc-950 px-4 py-3 text-lg font-semibold text-white" do %>
        <svg class="h-6 w-6 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        Подписки
      <% end %>

      <%= link_to "/settings", class: "flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white" do %>
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H5.78a1.65 1.65 0 0 0-1.51 1 1.65 1.65 0 0 0 .33 1.82l.07.08A10 10 0 0 0 12 17.66a10 10 0 0 0 6.26-2.58z"/>
          <path d="M16.5 6.5L19 9l-2.5 2.5"/>
          <path d="M7.5 6.5L5 9l2.5 2.5"/>
        </svg>
        Настройки
      <% end %>
    </nav>

    <% if user_signed_in? %>
      <%= button_to destroy_user_session_path, method: :delete, class: "mt-8 flex w-full items-center justify-center gap-2 rounded-full bg-indigo-500 px-6 py-3.5 text-base font-bold text-white transition hover:-translate-y-0.5 hover:bg-indigo-600 hover:shadow-lg hover:shadow-indigo-500/30" do %>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
        Выйти
      <% end %>
    <% end %>
  </aside>

  <!-- MAIN -->
  <main class="h-screen overflow-y-auto border-r border-zinc-900 bg-black">
    <div class="sticky top-0 z-30 border-b border-zinc-900 bg-black/95 px-6 py-4 backdrop-blur">
      <h1 class="text-[22px] font-bold text-white"><%= page_name %></h1>
    </div>

    <!-- TABS -->
    <div class="sticky top-[61px] z-20 flex border-b border-zinc-900 bg-black/95 backdrop-blur">
      <button class="relative flex-1 px-4 py-4 text-sm font-semibold text-white after:absolute after:bottom-0 after:left-1/2 after:h-[4px] after:w-16 after:-translate-x-1/2 after:rounded-full after:bg-indigo-500 after:shadow-lg after:shadow-indigo-500/30">
        Подписки
      </button>

      <button class="flex-1 px-4 py-4 text-sm font-semibold text-zinc-500 transition hover:bg-white/[0.02] hover:text-white">
        Подписчики
      </button>

      <button class="flex-1 px-4 py-4 text-sm font-semibold text-zinc-500 transition hover:bg-white/[0.02] hover:text-white">
        Рекомендации
      </button>
    </div>

    <!-- SEARCH -->
    <div class="border-b border-zinc-900 px-6 py-5">
      <div class="relative">
        <svg class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>

        <input
          type="text"
          placeholder="Поиск по подпискам..."
          class="w-full rounded-full border border-zinc-900 bg-zinc-950 py-3.5 pl-12 pr-5 text-[15px] text-white outline-none transition placeholder:text-zinc-500 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/20"
        >
      </div>
    </div>

    <!-- FOLLOWING LIST -->
    <section>
      <% following_users.each do |user| %>
        <article class="flex cursor-pointer gap-4 border-b border-zinc-900 px-6 py-5 transition hover:bg-zinc-950/70">
          <div class="relative h-14 w-14 shrink-0 rounded-full bg-gradient-to-br <%= user[:avatar_class] %>">
            <% if user[:online] %>
              <span class="absolute bottom-0 right-0 h-3.5 w-3.5 rounded-full border-2 border-black bg-emerald-500"></span>
            <% end %>
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <h2 class="truncate text-base font-bold text-white">
                    <%= user[:name] %>
                  </h2>

                  <% if user[:verified] %>
                    <span class="flex h-[18px] w-[18px] shrink-0 items-center justify-center rounded-full bg-indigo-500 text-[10px] text-white">
                      ✓
                    </span>
                  <% end %>
                </div>

                <div class="text-sm text-zinc-500">
                  <%= user[:handle] %>
                </div>
              </div>

              <button class="rounded-full border border-zinc-700 px-4 py-1.5 text-sm font-bold text-white transition hover:border-red-500 hover:bg-red-500/10 hover:text-red-500">
                Отписаться
              </button>
            </div>

            <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-zinc-200">
              <%= user[:bio] %>
            </p>

            <div class="mt-3 flex gap-5 text-xs text-zinc-500">
              <span>
                <strong class="text-white"><%= user[:posts] %></strong>
                постов
              </span>

              <span>
                <strong class="text-white"><%= user[:followers] %></strong>
                подписчиков
              </span>
            </div>
          </div>
        </article>
      <% end %>
    </section>
  </main>

  <!-- RIGHT SIDEBAR -->
  <aside class="h-screen overflow-y-auto bg-black p-5">
    <input
      type="text"
      placeholder="Глобальный поиск"
      class="w-full rounded-full border border-zinc-900 bg-zinc-950 px-5 py-3 text-[15px] text-white outline-none transition placeholder:text-zinc-500 focus:border-indigo-500"
    >

    <div class="mt-6 rounded-2xl border border-zinc-900 bg-zinc-950 p-5">
      <h3 class="mb-4 text-lg font-semibold text-white">
        Актуальное
      </h3>

      <% [["#Ycom", "Новая версия"], ["#Community", "Рост сообщества"], ["#Rails", "Новые идеи для проекта"]].each do |tag, title| %>
        <div class="mt-4 cursor-pointer group">
          <span class="text-sm text-zinc-500"><%= tag %></span>

          <div class="mt-1 font-semibold text-white transition group-hover:text-indigo-500">
            <%= title %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-6 rounded-2xl border border-zinc-900 bg-zinc-950 p-5">
      <h3 class="mb-4 text-lg font-semibold text-white">
        Кого читать
      </h3>

      <% recommended_users.each do |user| %>
        <div class="flex cursor-pointer items-center gap-3 border-b border-zinc-900 py-3 last:border-b-0">
          <div class="h-10 w-10 shrink-0 rounded-full bg-gradient-to-br <%= user[:avatar_class] %>"></div>

          <div class="min-w-0 flex-1">
            <div class="truncate text-sm font-semibold text-white">
              <%= user[:name] %>
            </div>

            <div class="truncate text-xs text-zinc-500">
              <%= user[:handle] %>
            </div>
          </div>

          <button class="text-sm font-bold text-indigo-500 transition hover:text-indigo-400">
            +
          </button>
        </div>
      <% end %>
    </div>
  </aside>

</div>