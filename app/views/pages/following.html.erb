<% content_for :title, "Подписки | Y.com" %>

<div class="fixed inset-0 mx-auto grid h-screen w-full max-w-[1400px] overflow-hidden bg-black text-white" style="grid-template-columns: 280px minmax(0, 1fr) 320px;">

  <!-- LEFT SIDEBAR -->
  <%= render "layouts/main_sidebar", active_tab: :following %>

  <!-- MAIN -->
  <main class="h-screen overflow-y-auto border-r border-zinc-900 bg-black">
    <div class="sticky top-0 z-30 border-b border-zinc-900 bg-black/95 px-6 py-4 backdrop-blur">
      <h1 class="text-[22px] font-bold text-white">Подписки</h1>
    </div>

    <!-- SEARCH -->
    <div class="border-b border-zinc-900 px-6 py-5">
      <%= form_with url: following_path, method: :get, local: true, data: { turbo: false }, class: "space-y-4" do %>
        <div class="relative">
          <svg class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <%= text_field_tag :q, @query, placeholder: "Поиск пользователей...", class: "w-full rounded-full border border-zinc-900 bg-zinc-950 py-3.5 pl-12 pr-5 text-[15px] text-white outline-none transition placeholder:text-zinc-500 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/20" %>
        </div>

        <div class="flex gap-3">
          <div class="flex-1">
            <label class="mb-1 block text-xs text-zinc-500">Возраст от</label>
            <%= number_field_tag :age_from, params[:age_from], placeholder: "18", min: 0, max: 150, class: "w-full rounded-full border border-zinc-900 bg-zinc-950 px-5 py-3 text-[15px] text-white outline-none placeholder:text-zinc-500 focus:border-indigo-500" %>
          </div>
          <div class="flex-1">
            <label class="mb-1 block text-xs text-zinc-500">Возраст до</label>
            <%= number_field_tag :age_to, params[:age_to], placeholder: "99", min: 0, max: 150, class: "w-full rounded-full border border-zinc-900 bg-zinc-950 px-5 py-3 text-[15px] text-white outline-none placeholder:text-zinc-500 focus:border-indigo-500" %>
          </div>
        </div>

        <%= submit_tag "Найти", class: "w-full cursor-pointer rounded-full bg-indigo-500 px-6 py-3 text-sm font-semibold text-white transition hover:bg-indigo-600" %>
      <% end %>
    </div>

    <!-- USERS LIST -->
    <section>
      <% if @users.any? %>
        <% @users.each do |user| %>
          <% display_name = user.name.presence || user.username %>
          <% display_initials = display_name.split.map { |part| part.first }.join[0, 2].to_s.upcase.presence || user.username.to_s.first(2).upcase %>
          <%= link_to user_path(user), class: "block" do %>
            <article class="flex cursor-pointer gap-4 border-b border-zinc-900 px-6 py-5 transition hover:bg-zinc-950/70">
              <div class="relative h-14 w-14 shrink-0 overflow-hidden rounded-full bg-gradient-to-br from-indigo-500 to-purple-950">
                <% if user.avatar.attached? %>
                  <%= image_tag user.avatar, class: "h-full w-full object-cover" %>
                <% else %>
                  <div class="flex h-full w-full items-center justify-center text-sm font-bold text-white"><%= display_initials %></div>
                <% end %>
              </div>

              <div class="min-w-0 flex-1">
                <div class="flex items-start justify-between gap-4">
                  <div class="min-w-0">
                    <h2 class="truncate text-base font-bold text-white"><%= display_name %></h2>
                    <div class="text-sm text-zinc-500">@<%= user.username %></div>
                  </div>
                </div>

                <% if user.status.present? %>
                  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-zinc-200"><%= user.status %></p>
                <% end %>

                <div class="mt-3 flex gap-5 text-xs text-zinc-500">
                  <span><strong class="text-white"><%= user.posts.count %></strong> постов</span>
                </div>
              </div>
            </article>
          <% end %>
        <% end %>
      <% elsif @query.present? %>
        <div class="px-6 py-12 text-center">
          <div class="text-lg font-semibold text-white">Ничего не найдено</div>
          <div class="mt-2 text-sm text-zinc-500">Пользователи с таким именем не зарегистрированы.</div>
        </div>
      <% else %>
        <div class="px-6 py-12 text-center">
          <div class="text-lg font-semibold text-white">Нет подписок</div>
          <div class="mt-2 text-sm text-zinc-500">Воспользуйтесь поиском, чтобы найти пользователей.</div>
        </div>
      <% end %>
    </section>
  </main>

  <!-- RIGHT SIDEBAR -->
  <aside class="h-screen overflow-y-auto bg-black p-5">
    <div class="rounded-2xl border border-zinc-900 bg-zinc-950 p-5">
      <h3 class="mb-4 text-lg font-semibold text-white">Актуальное</h3>

      <% [["#Ycom", "Новая версия"], ["#Community", "Рост сообщества"], ["#Rails", "Новые идеи для проекта"]].each do |tag, title| %>
        <div class="mt-4 cursor-pointer group">
          <span class="text-sm text-zinc-500"><%= tag %></span>
          <div class="mt-1 font-semibold text-white transition group-hover:text-indigo-500"><%= title %></div>
        </div>
      <% end %>
    </div>
  </aside>
</div>