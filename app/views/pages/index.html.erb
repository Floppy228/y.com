<script>
function previewPostImage(input) {
  const file = input.files[0]
  if (!file) return
  const reader = new FileReader()
  reader.onload = (e) => {
    const preview = document.querySelector("[data-post-compose-target='imagePreview']")
    preview.innerHTML = `
      <div class="relative mb-3 inline-block">
        <img src="${e.target.result}" class="max-h-48 max-w-full rounded-xl object-cover" />
        <button type="button" onclick="this.closest('[data-post-compose-target]').innerHTML = ''; this.closest('[data-post-compose-target]').classList.add('hidden')" class="absolute -right-2 -top-2 flex h-6 w-6 items-center justify-center rounded-full bg-zinc-800 text-xs text-white hover:bg-red-500">&times;</button>
      </div>`
    preview.classList.remove("hidden")
  }
  reader.readAsDataURL(file)
}
</script>
<div class="fixed inset-0 mx-auto grid h-screen w-full max-w-[1400px] grid-cols-[280px_1fr_320px] overflow-hidden bg-black text-white">
  <%= render "layouts/main_sidebar", active_tab: :index, show_quick_post: true %>

  <main class="h-screen overflow-y-auto border-r border-zinc-900 bg-black">
    <div class="sticky top-0 z-30 border-b border-zinc-900 bg-black/95 px-6 py-4 backdrop-blur">
      <h1 class="text-[22px] font-bold text-white">Главная</h1>
    </div>

    <div class="border-b border-zinc-900 px-6 py-5">
      <%= form_with url: posts_path, scope: :post, method: :post, local: true, multipart: true, class: "rounded-[20px] border border-zinc-900 bg-zinc-950 p-4 transition focus-within:border-indigo-500 focus-within:ring-4 focus-within:ring-indigo-500/20" do %>
        <%= text_area_tag "post[content]", nil, class: "min-h-20 w-full resize-none bg-transparent text-[17px] leading-relaxed text-white outline-none placeholder:text-zinc-500", placeholder: "Что нового?", rows: 3 %>

        <div data-post-compose-target="imagePreview" class="hidden"></div>

        <div class="mt-3 flex items-center justify-between border-t border-zinc-900 pt-3">
          <div class="flex gap-2">
            <label class="flex h-[38px] w-[38px] cursor-pointer items-center justify-center rounded-full border border-zinc-900 text-zinc-500 transition hover:border-indigo-500 hover:bg-zinc-900 hover:text-indigo-500">
              <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <%= file_field_tag "post[image]", accept: "image/*", class: "hidden", onchange: "previewPostImage(this)" %>
            </label>
          </div>

          <%= submit_tag "Опубликовать", class: "cursor-pointer rounded-full bg-indigo-500 px-6 py-2 text-sm font-semibold text-white transition hover:bg-indigo-600" %>
        </div>
      <% end %>
    </div>

    <section id="feed">
      <% if @posts.any? %>
        <%= render @posts %>
      <% else %>
        <div class="px-5 py-16 text-center text-zinc-500">
          <h3 class="mb-2 text-lg font-semibold text-white">Пока нет постов</h3>
          <p>Создай первый пост через форму выше — он появится здесь.</p>
        </div>
      <% end %>
    </section>
  </main>

  <aside class="h-screen overflow-y-auto bg-black p-5">
    <div>
      <input id="searchInput" type="text" placeholder="Поиск" class="w-full rounded-full border border-zinc-900 bg-zinc-950 px-5 py-3 text-[15px] text-white outline-none transition placeholder:text-zinc-500 focus:border-indigo-500">
    </div>

    <div class="mt-6 rounded-2xl border border-zinc-900 bg-zinc-950 p-5">
      <h3 class="mb-4 text-lg font-semibold text-white">Актуальное</h3>

      <% [["#Ycom", "Новая версия"], ["#Design", "Минимализм"], ["#AI", "Y-Core"]].each do |tag, title| %>
        <div class="mt-4 cursor-pointer group">
          <span class="text-sm text-zinc-500"><%= tag %></span>
          <div class="mt-1 font-semibold text-white transition group-hover:text-indigo-500"><%= title %></div>
        </div>
      <% end %>
    </div>
  </aside>
</div>

