<% content_for :title, "Сообщения | Y.com" %>

<div class="fixed inset-0 mx-auto grid h-screen w-full max-w-[1400px] overflow-hidden bg-black text-white" style="grid-template-columns: 280px minmax(0, 1fr) 320px;">
  <%= render "layouts/main_sidebar", active_tab: :messages %>

  <main class="h-screen overflow-hidden border-r border-zinc-900 bg-black">
    <div class="flex h-full flex-col">
      <div class="sticky top-0 z-30 border-b border-zinc-900 bg-black/95 px-6 py-4 backdrop-blur">
        <div class="flex items-center justify-between gap-3">
          <h1 class="text-[22px] font-bold text-white">Сообщения</h1>
          <% if @selected_user %>
            <%= button_to "Очистить чат", clear_messages_chat_path(user_id: @selected_user.id), method: :delete, class: "rounded-full border border-zinc-800 bg-zinc-950 px-4 py-2 text-xs font-semibold text-zinc-300 transition hover:border-indigo-500 hover:text-white" %>
          <% end %>
        </div>
      </div>

      <% if @selected_user %>
        <%= link_to user_path(@selected_user), class: "block shrink-0 border-b border-zinc-900 bg-black px-6 py-5 transition hover:bg-zinc-950" do %>
          <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-full bg-gradient-to-br from-indigo-500 to-purple-950 text-lg font-black text-white">
              <% if @selected_user.avatar.attached? %>
                <%= image_tag @selected_user.avatar, class: "h-full w-full object-cover" %>
              <% else %>
                <%= (@selected_user.name.presence || @selected_user.username).split.map { |part| part.first }.join[0, 2].to_s.upcase %>
              <% end %>
            </div>
            <div>
              <h2 class="text-2xl font-bold text-white"><%= @selected_user.name.presence || @selected_user.username %></h2>
              <p class="mt-1 text-sm text-zinc-500"><%= @selected_user.status.presence || "@#{@selected_user.username}" %></p>
            </div>
          </div>
        <% end %>

        <section data-controller="chat-scroll" class="flex-1 overflow-y-auto px-6 py-6">
          <div class="space-y-5">
            <% if @direct_messages.any? %>
              <% @direct_messages.each do |message| %>
                <% own_message = message.sender_id == current_user.id %>
                <% sender = own_message ? current_user : @selected_user %>
                <div class="flex items-end <%= own_message ? 'justify-end' : '' %> gap-3">
                  <% unless own_message %>
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-gradient-to-br from-indigo-500 to-purple-950 text-sm font-bold text-white">
                      <% if sender.avatar.attached? %>
                        <%= image_tag sender.avatar, class: "h-full w-full object-cover" %>
                      <% else %>
                        <%= (sender.name.presence || sender.username).split.map { |part| part.first }.join[0, 2].to_s.upcase.presence || sender.username.to_s.first(2).upcase %>
                      <% end %>
                    </div>
                  <% end %>

                  <div class="<%= own_message ? 'border border-indigo-500/30 bg-indigo-500/10 text-zinc-100' : 'border border-zinc-900 bg-zinc-950 text-zinc-200' %> relative inline-flex h-auto w-fit max-w-[75%] shrink-0 flex-col rounded-2xl px-4 py-2.5 pr-10 text-sm leading-6">
                    <% if own_message %>
                      <details class="absolute right-1 top-1 z-20 h-6 w-6">
                        <summary class="block h-6 w-6 list-none cursor-pointer rounded-full text-zinc-300 outline-none ring-0 focus:outline-none focus:ring-0 [&::-webkit-details-marker]:hidden hover:bg-zinc-900 hover:text-white">
                          <span class="flex h-6 w-6 items-center justify-center text-xs leading-none">...</span>
                        </summary>
                        <div class="absolute right-0 top-7 min-w-[170px] rounded-xl border border-zinc-800 bg-zinc-950 p-2 shadow-xl">
                          <details class="group">
                            <summary class="list-none cursor-pointer rounded-lg px-2 py-1.5 text-xs text-zinc-200 hover:bg-zinc-900 hover:text-white">Изменить</summary>
                            <div class="pt-2">
                              <%= form_with url: update_message_path(message), method: :patch, local: true, data: { turbo: false }, class: "space-y-2" do %>
                                <%= text_area_tag :content, message.content, rows: 2, class: "w-full min-w-[220px] rounded-xl border border-zinc-700 bg-zinc-950 px-3 py-2 text-xs text-white outline-none focus:border-indigo-500" %>
                                <button type="submit" class="rounded-full border border-zinc-700 px-3 py-1 text-[11px] font-semibold text-zinc-200 hover:border-indigo-500 hover:text-white">Сохранить</button>
                              <% end %>
                            </div>
                          </details>

                          <%= button_to "Удалить", destroy_message_path(message), method: :delete, form: { data: { turbo: false } }, class: "mt-2 w-full rounded-lg px-3 py-1.5 text-left text-xs font-semibold text-zinc-300 hover:bg-zinc-900 hover:text-red-300" %>
                        </div>
                      </details>
                    <% end %>

                    <div class="whitespace-pre-wrap break-words"><%= message.content %></div>
                    <div class="mt-1.5 text-[10px] <%= own_message ? 'text-indigo-100/80' : 'text-zinc-500' %>">
                      <%= l(message.created_at, format: "%H:%M") %>
                    </div>
                  </div>

                  <% if own_message %>
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-zinc-900 text-sm font-bold text-white">
                      <% if current_user.avatar.attached? %>
                        <%= image_tag current_user.avatar, class: "h-full w-full object-cover" %>
                      <% else %>
                        Я
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <div class="flex h-[40vh] items-center justify-center">
                <div class="text-center">
                  <div class="text-xl font-semibold text-white">Начните диалог</div>
                  <div class="mt-2 text-sm text-zinc-500">Напишите первое сообщение для этого пользователя.</div>
                </div>
              </div>
            <% end %>
          </div>
        </section>

        <div class="border-t border-zinc-900 bg-black px-6 py-5">
          <%= form_with url: create_message_path, method: :post, local: true, data: { turbo: false, controller: "message-compose", message_compose_shortcut_value: current_user.message_send_shortcut }, class: "rounded-[20px] border border-zinc-900 bg-zinc-950 p-4 transition focus-within:border-indigo-500 focus-within:ring-4 focus-within:ring-indigo-500/20" do %>
            <%= hidden_field_tag :recipient_id, @selected_user.id %>
            <%= text_area_tag :content, nil, rows: 2, placeholder: "Написать сообщение...", data: { message_compose_target: "input", action: "keydown->message-compose#submitOnShortcut" }, class: "min-h-[54px] w-full resize-none bg-transparent text-[17px] leading-relaxed text-white outline-none placeholder:text-zinc-500" %>

            <div class="mt-3 flex items-center justify-between border-t border-zinc-900 pt-3">
              <div class="text-xs text-zinc-500">
                <% if current_user.message_send_shortcut == "ctrl_enter" %>
                  Отправка: Ctrl+Enter. Новая строка: Enter.
                <% else %>
                  Отправка: Enter. Новая строка: Ctrl+Enter.
                <% end %>
              </div>

              <button type="submit" class="rounded-full bg-indigo-500 px-6 py-2 text-sm font-semibold text-white transition hover:bg-indigo-600">Отправить</button>
            </div>
          <% end %>
        </div>
      <% else %>
        <section class="flex flex-1 items-center justify-center px-6">
          <div class="max-w-md text-center">
            <div class="text-3xl font-bold text-white">Напишите кому-нибудь..</div>
            <p class="mt-3 text-sm text-zinc-500">Найдите пользователя справа сверху, чтобы начать новый чат.</p>
          </div>
        </section>
      <% end %>
    </div>
  </main>

  <aside class="flex h-screen flex-col bg-black p-5">
    <%= form_with url: messages_path, method: :get, local: true, data: { turbo: false }, class: "shrink-0" do %>
      <%= hidden_field_tag :user_id, @selected_user&.id %>
      <%= text_field_tag :q, @query, placeholder: "Поиск пользователя", class: "w-full rounded-full border border-zinc-900 bg-zinc-950 px-5 py-3 text-[15px] text-white outline-none placeholder:text-zinc-500 focus:border-indigo-500" %>
    <% end %>

    <% if @query.present? %>
      <div class="mt-6 shrink-0 rounded-2xl border border-zinc-900 bg-zinc-950 p-5">
        <h3 class="mb-4 text-lg font-semibold text-white">Результаты поиска</h3>

        <% if @search_users.any? %>
          <div class="space-y-3">
            <% @search_users.each do |user| %>
              <% display_name = user.name.presence || user.username %>
              <% display_initials = display_name.split.map { |part| part.first }.join[0, 2].to_s.upcase.presence || user.username.to_s.first(2).upcase %>
              <%= link_to messages_path(user_id: user.id, q: @query), class: "block w-full rounded-xl border border-zinc-800 bg-zinc-950 px-3 py-3 text-left transition hover:bg-zinc-900" do %>
                <div class="flex items-center gap-3">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-gradient-to-br from-indigo-500 to-purple-950 text-xs font-semibold text-white">
                    <% if user.avatar.attached? %>
                      <%= image_tag user.avatar, class: "h-full w-full object-cover" %>
                    <% else %>
                      <%= display_initials %>
                    <% end %>
                  </div>

                  <div class="min-w-0">
                    <div class="truncate text-sm font-semibold text-white"><%= display_name %></div>
                    <div class="mt-1 truncate text-xs text-zinc-500">@<%= user.username %></div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="text-sm text-zinc-500">Никого не найдено.</div>
        <% end %>
      </div>
    <% end %>

    <div class="mt-6 flex-1 overflow-y-auto rounded-2xl border border-zinc-900 bg-zinc-950 p-5">
      <h3 class="mb-4 text-lg font-semibold text-white">Чаты</h3>

      <% if @chat_rows.any? %>
        <div class="space-y-3">
          <% @chat_rows.each do |row| %>
            <% user = row[:user] %>
            <% display_name = user.name.presence || user.username %>
            <% display_initials = display_name.split.map { |part| part.first }.join[0, 2].to_s.upcase.presence || user.username.to_s.first(2).upcase %>
            <%= link_to messages_path(user_id: user.id), class: "block w-full rounded-xl border px-3 py-3 text-left transition #{row[:active] ? 'border-indigo-500/40 bg-zinc-900' : 'border-zinc-800 bg-zinc-950 hover:bg-zinc-900'}" do %>
              <div class="flex items-start gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-gradient-to-br from-indigo-500 to-purple-950 text-xs font-semibold text-white">
                  <% if user.avatar.attached? %>
                    <%= image_tag user.avatar, class: "h-full w-full object-cover" %>
                  <% else %>
                    <%= display_initials %>
                  <% end %>
                </div>

                <div class="min-w-0 flex-1">
                  <div class="flex items-start justify-between gap-3">
                    <div class="truncate text-sm font-semibold text-white"><%= display_name %></div>
                    <div class="shrink-0 text-xs text-zinc-500"><%= row[:time] ? l(row[:time], format: "%H:%M") : "" %></div>
                  </div>
                  <div class="mt-1 truncate text-xs text-zinc-500"><%= row[:preview] %></div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="py-8 text-center">
          <div class="text-sm font-semibold text-white">Чатов пока нет</div>
          <div class="mt-2 text-xs text-zinc-500">Найдите человека через поиск выше и начните диалог.</div>
        </div>
      <% end %>
    </div>
  </aside>
</div>
