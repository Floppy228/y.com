<% content_for :title, "Смена пароля | Y.com" %>

<div class="fixed inset-0 mx-auto grid h-screen w-full max-w-[1400px] overflow-hidden bg-black text-white" style="grid-template-columns: 280px minmax(0, 1fr) 320px;">
  <%= render "layouts/main_sidebar", active_tab: :settings %>

  <main class="h-screen overflow-y-auto border-r border-zinc-900 bg-black">
    <div class="sticky top-0 z-30 border-b border-zinc-900 bg-black/95 px-6 py-4 backdrop-blur">
      <h1 class="text-[22px] font-bold text-white">Смена пароля</h1>
    </div>

    <section class="space-y-6 p-8">
      <div class="max-w-2xl rounded-2xl border border-zinc-900 bg-zinc-950 p-6">
        <h2 class="text-lg font-bold text-white">Подтверждение по email</h2>
        <p class="mt-2 text-sm text-zinc-400">
          Код будет отправлен на адрес:
        </p>
        <div class="mt-3 inline-flex rounded-full border border-zinc-800 bg-black px-4 py-2 text-sm font-semibold text-white">
          <%= @user.email %>
        </div>
        <p class="mt-3 text-xs text-zinc-500">
          Если это не тот адрес, сначала измените email в настройках аккаунта.
        </p>

        <div class="mt-5">
          <%= form_with url: settings_password_reset_send_code_path, method: :post, local: true, data: { turbo: false } do %>
            <button type="submit" class="rounded-full bg-indigo-500 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-600">
              Отправить код на email
            </button>
          <% end %>
        </div>
      </div>

      <div class="max-w-2xl rounded-2xl border border-zinc-900 bg-zinc-950 p-6">
        <h2 class="text-lg font-bold text-white">Новый пароль</h2>
        <p class="mt-2 text-sm text-zinc-400">
          Введите код из письма, затем новый пароль и его подтверждение.
        </p>

        <%= form_with url: settings_password_reset_update_path, method: :patch, local: true, data: { turbo: false }, class: "mt-5 space-y-5" do %>
          <div>
            <label class="mb-2 block text-sm font-medium text-zinc-400">Код из письма</label>
            <%= text_field_tag :code, nil, autocomplete: "one-time-code", class: "w-full max-w-md rounded-xl border border-zinc-800 bg-black px-4 py-3 text-sm text-white outline-none focus:border-indigo-500" %>
          </div>

          <div>
            <label class="mb-2 block text-sm font-medium text-zinc-400">Новый пароль</label>
            <%= password_field_tag :password, nil, autocomplete: "new-password", class: "w-full max-w-md rounded-xl border border-zinc-800 bg-black px-4 py-3 text-sm text-white outline-none focus:border-indigo-500" %>
          </div>

          <div>
            <label class="mb-2 block text-sm font-medium text-zinc-400">Повторите пароль</label>
            <%= password_field_tag :password_confirmation, nil, autocomplete: "new-password", class: "w-full max-w-md rounded-xl border border-zinc-800 bg-black px-4 py-3 text-sm text-white outline-none focus:border-indigo-500" %>
          </div>

          <div class="flex gap-3">
            <button type="submit" class="rounded-full bg-indigo-500 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-600">
              Сохранить новый пароль
            </button>

            <%= link_to "Назад в настройки", settings_path, class: "rounded-full border border-zinc-700 px-6 py-2.5 text-sm font-semibold text-zinc-200 transition hover:border-indigo-500 hover:text-white" %>
          </div>
        <% end %>
      </div>
    </section>
  </main>

  <aside class="h-screen overflow-y-auto bg-black p-5">
    <div class="rounded-2xl border border-zinc-900 bg-zinc-950 p-5">
      <h3 class="mb-3 text-base font-semibold text-white">Подсказка</h3>
      <p class="text-sm text-zinc-500">Код действует 15 минут. После нажатия кнопки проверьте Входящие, Спам и Промоакции именно для адреса, который показан слева.</p>
    </div>
    <div class="mt-5 rounded-2xl border border-zinc-900 bg-zinc-950 p-5">
      <h3 class="mb-3 text-base font-semibold text-white">Текущий аккаунт</h3>
      <p class="text-sm text-zinc-400"><%= @user.username %></p>
      <p class="mt-1 text-sm text-zinc-500"><%= @user.email %></p>
    </div>
  </aside>
</div>
