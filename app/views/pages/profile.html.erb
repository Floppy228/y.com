<%
  profile_name = @user.name.presence || @user.username.presence || "Пользователь"
  profile_handle = @user.username.present? ? "@#{@user.username}" : "@user"
  profile_bio = @user.respond_to?(:bio) && @user.bio.present? ? @user.bio : "Добавьте описание в настройках профиля."
  profile_initials = profile_name.split.map { |part| part.first }.join[0, 2].to_s.upcase

  posts_count = @user.respond_to?(:posts_count) ? @user.posts_count : 0
  following_count = @user.respond_to?(:following_count) ? @user.following_count : 0
  followers_count = @user.respond_to?(:followers_count) ? @user.followers_count : 0
%>

<div class="fixed inset-0 mx-auto grid h-screen w-full max-w-[1400px] grid-cols-[280px_1fr_320px] overflow-hidden bg-black text-white">
  <aside class="h-screen overflow-y-auto border-r border-zinc-900 bg-black px-4 py-5">
    <a href="/" class="mb-8 inline-block bg-gradient-to-br from-white to-indigo-500 bg-clip-text pl-3 text-[42px] font-black tracking-[-1.5px] text-transparent">
      Y.com
    </a>

    <nav class="flex flex-col gap-1">
      <a href="/" class="flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Главная
      </a>

      <a href="/profile" class="flex items-center gap-4 rounded-full bg-zinc-950 px-4 py-3 text-lg font-semibold text-white">
        <svg class="h-6 w-6 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        Профиль
      </a>

      <a href="/messages" class="flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        Сообщения
      </a>

      <a href="/ai" class="flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 8v8M8 12h8"/>
        </svg>
        Y-Core
      </a>

      <a href="/following" class="flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        Подписки
      </a>

      <a href="/settings" class="flex items-center gap-4 rounded-full px-4 py-3 text-lg font-medium text-zinc-500 transition hover:bg-zinc-950 hover:text-white">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H5.78a1.65 1.65 0 0 0-1.51 1 1.65 1.65 0 0 0 .33 1.82l.07.08A10 10 0 0 0 12 17.66a10 10 0 0 0 6.26-2.58z"/>
          <path d="M16.5 6.5L19 9l-2.5 2.5"/>
          <path d="M7.5 6.5L5 9l2.5 2.5"/>
        </svg>
        Настройки
      </a>
    </nav>

    <% if user_signed_in? %>
      <%= button_to destroy_user_session_path, method: :delete, class: "mt-8 flex w-full items-center justify-center gap-2 rounded-full bg-indigo-500 px-6 py-3.5 text-base font-bold text-white transition hover:-translate-y-0.5 hover:bg-indigo-600 hover:shadow-lg hover:shadow-indigo-500/30" do %>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
        Выйти
      <% end %>
    <% end %>
  </aside>

  <main class="h-screen overflow-y-auto border-r border-zinc-900 bg-black">
    <div class="sticky top-0 z-30 flex items-center gap-5 border-b border-zinc-900 bg-black/95 px-6 py-2 backdrop-blur">
      <h1 class="text-xl font-bold text-white"><%= profile_name %></h1>
      <span class="rounded-full border border-zinc-900 bg-zinc-950 px-3 py-1 text-xs text-zinc-500">
        <%= posts_count %> постов
      </span>
    </div>

    <div class="flex h-[180px] items-center justify-center border-b border-zinc-900 bg-gradient-to-br from-zinc-900 via-black to-indigo-950 text-2xl font-semibold text-indigo-500/50">
      Y.com Cover
    </div>

    <section class="border-b border-zinc-900 px-4 pb-6 pt-4">
      <div class="flex items-start gap-4">
        <div class="shrink-0 rounded-full bg-black p-1 shadow-2xl">
        <div class="flex h-[100px] w-[100px] items-center justify-center rounded-full border-4 border-black bg-gradient-to-br from-indigo-500 to-purple-950 text-4xl font-bold text-white">
          <%= profile_initials %>
        </div>
        </div>

      <div class="min-w-0 pt-1">
        <div class="flex items-center gap-2 text-xl font-extrabold text-white">
          <%= profile_name %>
          <span class="flex h-[18px] w-[18px] items-center justify-center rounded-full bg-indigo-500 text-[10px] text-white">✓</span>
        </div>

        <div class="mt-0.5 text-sm text-zinc-500">
          <%= profile_handle %>
        </div>

        <p class="my-3 text-sm leading-relaxed text-zinc-200">
          <%= profile_bio %>
        </p>

        <div class="my-3 flex flex-wrap gap-4 text-xs text-zinc-500">
          <div class="flex items-center gap-1">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <circle cx="12" cy="8" r="4"/>
              <path d="M5.5 20v-2a6.5 6.5 0 0 1 13 0v2"/>
            </svg>
            <span>С <%= @user.created_at.strftime("%B %Y") %></span>
          </div>

          <div class="flex items-center gap-1">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
            <span>15 апреля 1995</span>
          </div>

          <div class="flex items-center gap-1">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M3 12h3l3-9 3 18 3-9h3"/>
            </svg>
            <span>y.com/<%= @user.username.presence || "user" %></span>
          </div>
        </div>

        <div class="flex gap-5 text-sm text-zinc-500">
          <span><strong class="mr-1 text-base text-white"><%= following_count %></strong>подписок</span>
          <span><strong class="mr-1 text-base text-white"><%= followers_count %></strong>подписчиков</span>
          <span><strong class="mr-1 text-base text-white"><%= posts_count %></strong>постов</span>
        </div>
      </div>
      </div>
    </section>

    <div class="sticky top-[53px] z-20 flex border-b border-zinc-900 bg-black/95 backdrop-blur">
      <button class="relative flex-1 px-4 py-3.5 text-sm font-semibold text-white after:absolute after:bottom-0 after:left-1/2 after:h-[3px] after:w-10 after:-translate-x-1/2 after:rounded-full after:bg-indigo-500">
        Посты
      </button>
      <button class="flex-1 px-4 py-3.5 text-sm font-semibold text-zinc-500 transition hover:bg-white/[0.02] hover:text-white">
        Ответы
      </button>
      <button class="flex-1 px-4 py-3.5 text-sm font-semibold text-zinc-500 transition hover:bg-white/[0.02] hover:text-white">
        Медиа
      </button>
      <button class="flex-1 px-4 py-3.5 text-sm font-semibold text-zinc-500 transition hover:bg-white/[0.02] hover:text-white">
        Лайки
      </button>
    </div>

    <div>
      <% if @posts.any? %>
        <%= render @posts %>
      <% else %>
        <div class="px-5 py-16 text-center text-zinc-500">
          <h3 class="mb-2 text-base font-semibold text-white">Нет постов</h3>
          <p class="text-sm">Здесь появятся твои публикации.</p>
        </div>
      <% end %>
    </div>
  </main>

  <aside class="h-screen overflow-y-auto bg-black p-5">
    <div>
      <input id="searchInput" type="text" placeholder="Поиск" class="w-full rounded-full border border-zinc-900 bg-zinc-950 px-5 py-3 text-[15px] text-white outline-none transition placeholder:text-zinc-500 focus:border-indigo-500">
    </div>

    <div class="mt-6 rounded-2xl border border-zinc-900 bg-zinc-950 p-5">
      <h3 class="mb-4 text-lg font-semibold text-white">Актуальное</h3>

      <% [["#Ycom", "Новая версия"], ["#Design", "Минимализм"], ["#AI", "Y-Core"]].each do |tag, title| %>
        <div class="mt-4 cursor-pointer group">
          <span class="text-sm text-zinc-500"><%= tag %></span>
          <div class="mt-1 font-semibold text-white transition group-hover:text-indigo-500"><%= title %></div>
        </div>
      <% end %>
    </div>

    <div class="mt-5 rounded-2xl border border-zinc-900 bg-zinc-950 p-4">
      <h3 class="mb-3 text-base font-semibold text-white">Кого читать</h3>

      <div class="mt-3 flex cursor-pointer items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-purple-950 text-sm font-semibold text-white">
          TA
        </div>
        <div>
          <div class="text-sm font-semibold text-white">Tech Analytics</div>
          <div class="text-xs text-zinc-500">@tech_data</div>
        </div>
      </div>

      <div class="mt-3 flex cursor-pointer items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-purple-950 text-sm font-semibold text-white">
          YN
        </div>
        <div>
          <div class="text-sm font-semibold text-white">Y.com News</div>
          <div class="text-xs text-zinc-500">@y_official</div>
        </div>
      </div>
    </div>
  </aside>
</div>
