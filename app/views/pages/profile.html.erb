<%
  profile_name = @user.name.presence || @user.username.presence || "Пользователь"
  profile_handle = @user.username.present? ? "@#{@user.username}" : "@user"
  profile_bio = @user.bio.presence || "Добавьте описание в настройках профиля."
  profile_status = @user.status.presence || "Без статуса"
  profile_initials = profile_name.split.map { |part| part.first }.join[0, 2].to_s.upcase

  posts_count = @user.posts_count
  following_count = @user.following_count
  followers_count = @user.followers_count
%>

<div class="fixed inset-0 mx-auto grid h-screen w-full max-w-[1400px] grid-cols-[280px_1fr_320px] overflow-hidden bg-black text-white">
  <%= render "layouts/main_sidebar", active_tab: @user == current_user ? :profile : nil %>

  <main class="h-screen overflow-y-auto border-r border-zinc-900 bg-black">
    <div class="sticky top-0 z-30 flex items-center gap-5 border-b border-zinc-900 bg-black/95 px-6 py-4 backdrop-blur">
      <h1 class="text-[22px] font-bold text-white"><%= profile_name %></h1>
    </div>

    <div class="relative h-[180px] border-b border-zinc-900 bg-gradient-to-br from-zinc-900 via-black to-indigo-950">
      <% if @user.cover_image.attached? %>
        <%= image_tag @user.cover_image, class: "h-full w-full object-cover" %>
      <% else %>
        <div class="flex h-full items-center justify-center text-2xl font-semibold text-indigo-500/50">Y.com Cover</div>
      <% end %>
    </div>

    <section class="border-b border-zinc-900 px-4 pb-6 pt-4">
      <div class="flex items-start gap-4">
        <div class="shrink-0 rounded-full bg-black p-1 shadow-2xl">
        <div class="flex h-[100px] w-[100px] items-center justify-center overflow-hidden rounded-full border-4 border-black bg-gradient-to-br from-indigo-500 to-purple-950 text-4xl font-bold text-white">
          <% if @user.avatar.attached? %>
            <%= image_tag @user.avatar, class: "h-full w-full object-cover" %>
          <% else %>
            <%= profile_initials %>
          <% end %>
        </div>
        </div>

      <div class="min-w-0 pt-1">
        <div class="flex items-center gap-2 text-xl font-extrabold text-white">
          <%= profile_name %>
          <span class="flex h-[18px] w-[18px] items-center justify-center rounded-full bg-indigo-500 text-[10px] text-white">✓</span>
        </div>

        <div class="mt-0.5 text-sm text-zinc-500">
          <%= profile_handle %>
        </div>

        <% if @banned_user %>
          <div class="mb-2 mt-2 rounded-lg border border-red-900/50 bg-red-950/30 px-4 py-2 text-sm text-red-400">
            <strong>Аккаунт заблокирован</strong>
            <% if @user.ban_reason.present? %>
              <p class="mt-0.5 text-xs text-red-400/80">Причина: <%= @user.ban_reason %></p>
            <% end %>
          </div>
        <% end %>

        <div class="mt-2 inline-flex items-center rounded-full border border-zinc-800 bg-zinc-950 px-3 py-1 text-xs text-zinc-300">
          <%= profile_status %>
        </div>

        <p class="my-3 text-sm leading-relaxed text-zinc-200">
          <%= profile_bio %>
        </p>

        <div class="my-3 flex flex-wrap gap-4 text-xs text-zinc-500">
          <div class="flex items-center gap-1">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <circle cx="12" cy="8" r="4"/>
              <path d="M5.5 20v-2a6.5 6.5 0 0 1 13 0v2"/>
            </svg>
            <span>С <%= @user.created_at.strftime("%B %Y") %></span>
          </div>

          <% if @user.birthday.present? %>
            <div class="flex items-center gap-1">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 6v6l4 2"/>
              </svg>
              <span>
                <%= I18n.l(@user.birthday, format: "%-d %B %Y") %>
              </span>
            </div>
          <% end %>

          <div class="flex items-center gap-1">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M3 12h3l3-9 3 18 3-9h3"/>
            </svg>
            <span>y.com/<%= @user.username.presence || "user" %></span>
          </div>
        </div>

        <div class="flex gap-5 text-sm text-zinc-500">
          <span><strong class="mr-1 text-base text-white"><%= following_count %></strong>подписок</span>
          <span><strong class="mr-1 text-base text-white"><%= followers_count %></strong>подписчиков</span>
          <span><strong class="mr-1 text-base text-white"><%= posts_count %></strong>постов</span>
        </div>

        <% if user_signed_in? && @user != current_user %>
          <% fs = current_user.friendship_status_with(@user) %>
          <div class="mt-4">
            <% if fs == "none" %>
              <%= link_to "Добавить в друзья", send_friend_request_path(@user), data: { turbo_method: :post }, class: "inline-flex items-center justify-center rounded-full border border-transparent bg-indigo-500 px-6 py-2 text-sm font-semibold leading-none text-white transition hover:bg-indigo-600" %>
            <% elsif fs == "pending_to" %>
              <span class="inline-flex items-center justify-center rounded-full border border-zinc-700 bg-zinc-950 px-6 py-2 text-sm leading-none text-zinc-400">Запрос отправлен</span>
            <% elsif fs == "pending_from" %>
              <div class="flex gap-2">
                <%= link_to "Принять", accept_friend_request_path(@user), data: { turbo_method: :patch }, class: "inline-flex items-center justify-center rounded-full border border-transparent bg-indigo-500 px-6 py-2 text-sm font-semibold leading-none text-white transition hover:bg-indigo-600" %>
                <%= link_to "Отклонить", reject_friend_request_path(@user), data: { turbo_method: :delete }, class: "inline-flex items-center justify-center rounded-full border border-zinc-700 px-6 py-2 text-sm font-semibold leading-none text-zinc-300 transition hover:border-red-500 hover:text-red-400" %>
              </div>
            <% elsif fs == "accepted" %>
              <div class="flex gap-2">
                <span class="flex flex-1 items-center justify-center rounded-full border border-indigo-500/50 bg-indigo-500/10 px-6 py-2 text-sm leading-none text-indigo-400">Вы в друзьях</span>
                <%= link_to "Удалить из друзей", unfriend_path(@user), data: { turbo_method: :delete }, class: "flex flex-1 items-center justify-center rounded-full border border-zinc-700 px-6 py-2 text-sm leading-none text-zinc-400 transition hover:border-red-500 hover:text-red-400" %>
              </div>
            <% end %>

            <div class="mt-3 flex flex-wrap gap-2">
              <%= link_to "Написать", messages_path(user_id: @user.id), class: "flex flex-1 items-center justify-center rounded-full border border-transparent bg-indigo-500 px-6 py-2 text-sm font-semibold leading-none text-white transition hover:bg-indigo-600" %>
              <% if current_user.blocked?(@user) %>
                <%= link_to "Разблокировать", unblock_user_path(@user), data: { turbo_method: :delete }, class: "flex flex-1 items-center justify-center rounded-full border border-zinc-700 px-6 py-2 text-sm leading-none text-zinc-400 transition hover:border-red-500 hover:text-red-400" %>
              <% else %>
                <%= link_to "Заблокировать", block_user_path(@user), data: { turbo_method: :post }, class: "flex flex-1 items-center justify-center rounded-full border border-zinc-700 px-6 py-2 text-sm leading-none text-zinc-400 transition hover:border-red-500 hover:text-red-400" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      </div>
    </section>

    <div class="sticky top-[53px] z-20 border-b border-zinc-900 bg-black/95 backdrop-blur">
      <div class="relative flex-1 px-4 py-3.5 text-sm font-semibold text-white after:absolute after:bottom-0 after:left-1/2 after:h-[3px] after:w-10 after:-translate-x-1/2 after:rounded-full after:bg-indigo-500 text-center">
        Посты
      </div>
    </div>

    <div>
      <% if @blocked_by_them %>
        <div class="px-5 py-16 text-center text-zinc-500">
          <h3 class="mb-2 text-base font-semibold text-white">Пользователь вас заблокировал</h3>
          <p class="text-sm">Вы не можете просматривать профиль этого пользователя.</p>
        </div>
      <% elsif @posts.any? %>
        <%= render @posts %>
      <% else %>
        <div class="px-5 py-16 text-center text-zinc-500">
          <h3 class="mb-2 text-base font-semibold text-white">Нет постов</h3>
          <p class="text-sm">Здесь появятся твои публикации.</p>
        </div>
      <% end %>
    </div>
  </main>

  <aside class="h-screen overflow-y-auto bg-black p-5">
    <div>
      <input id="searchInput" type="text" placeholder="Поиск" class="w-full rounded-full border border-zinc-900 bg-zinc-950 px-5 py-3 text-[15px] text-white outline-none transition placeholder:text-zinc-500 focus:border-indigo-500">
    </div>

    <div class="mt-6 rounded-2xl border border-zinc-900 bg-zinc-950 p-5">
      <h3 class="mb-4 text-lg font-semibold text-white">Актуальное</h3>

      <% [["#Ycom", "Новая версия"], ["#Design", "Минимализм"], ["#AI", "Y-Core"]].each do |tag, title| %>
        <%= link_to root_path(q: tag), class: "mt-4 block group" do %>
          <span class="text-sm text-zinc-500"><%= tag %></span>
          <div class="mt-1 font-semibold text-white transition group-hover:text-indigo-500"><%= title %></div>
        <% end %>
      <% end %>
    </div>


  </aside>
</div>

