<% content_for :title, "Настройки | Y.com" %>

<div class="fixed inset-0 mx-auto grid h-screen w-full max-w-[1400px] overflow-hidden bg-black text-white" style="grid-template-columns: 280px minmax(0, 1fr) 320px;">
  <%= render "layouts/main_sidebar", active_tab: :settings %>

  <main class="h-screen overflow-y-auto border-r border-zinc-900 bg-black" data-controller="settings-nav" data-settings-nav-offset-value="88" data-action="scroll->settings-nav#updateActiveLink">
    <div class="sticky top-0 z-30 border-b border-zinc-900 bg-black/95 px-6 py-4 backdrop-blur">
      <h1 class="text-[22px] font-bold text-white">Настройки</h1>
    </div>

    <section class="grid min-h-[calc(100vh-61px)] grid-cols-[260px_minmax(0,1fr)]">
      <aside class="border-r border-zinc-900 bg-black p-5">
        <div class="rounded-2xl border border-zinc-900 bg-zinc-950 p-3">
          <a href="#account" data-settings-nav-target="link" data-section-id="account" data-action="click->settings-nav#scrollToSection" class="mb-2 flex items-center gap-3 rounded-xl bg-indigo-500/10 px-3 py-2.5 text-sm font-semibold text-white">
            <span data-settings-nav-dot class="h-2 w-2 rounded-full bg-indigo-500"></span> Аккаунт
          </a>
          <a href="#profile" data-settings-nav-target="link" data-section-id="profile" data-action="click->settings-nav#scrollToSection" class="mb-2 flex items-center gap-3 rounded-xl bg-zinc-900 px-3 py-2.5 text-sm font-medium text-zinc-400 transition hover:text-white">
            <span data-settings-nav-dot class="h-2 w-2 rounded-full bg-zinc-600"></span> Профиль
          </a>
          <a href="#chats" data-settings-nav-target="link" data-section-id="chats" data-action="click->settings-nav#scrollToSection" class="mb-2 flex items-center gap-3 rounded-xl bg-zinc-900 px-3 py-2.5 text-sm font-medium text-zinc-400 transition hover:text-white">
            <span data-settings-nav-dot class="h-2 w-2 rounded-full bg-zinc-600"></span> Чаты
          </a>
          <a href="#security" data-settings-nav-target="link" data-section-id="security" data-action="click->settings-nav#scrollToSection" class="flex items-center gap-3 rounded-xl bg-zinc-900 px-3 py-2.5 text-sm font-medium text-zinc-400 transition hover:text-white">
            <span data-settings-nav-dot class="h-2 w-2 rounded-full bg-zinc-600"></span> Безопасность
          </a>
        </div>
      </aside>

      <div class="space-y-8 p-8">
        <section id="account" data-settings-nav-target="section" class="rounded-2xl border border-zinc-900 bg-zinc-950">
          <div class="border-b border-zinc-900 px-6 py-4">
            <h2 class="text-lg font-bold text-white">Аккаунт</h2>
          </div>

          <%= form_with model: @user, url: settings_account_path, method: :patch, local: true, class: "space-y-5 px-6 py-5" do |f| %>
            <div>
              <label class="mb-2 block text-sm font-medium text-zinc-400">Username</label>
              <%= f.text_field :username, class: "w-full max-w-md rounded-xl border border-zinc-800 bg-black px-4 py-3 text-sm text-white outline-none focus:border-indigo-500" %>
            </div>

            <div>
              <label class="mb-2 block text-sm font-medium text-zinc-400">Email</label>
              <%= f.email_field :email, class: "w-full max-w-md rounded-xl border border-zinc-800 bg-black px-4 py-3 text-sm text-white outline-none focus:border-indigo-500" %>
            </div>

            <button type="submit" class="rounded-full bg-indigo-500 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-600">Сохранить аккаунт</button>
          <% end %>
        </section>

        <section id="profile" data-settings-nav-target="section" class="rounded-2xl border border-zinc-900 bg-zinc-950">
          <div class="border-b border-zinc-900 px-6 py-4">
            <h2 class="text-lg font-bold text-white">Профиль</h2>
          </div>

          <%= form_with model: @user, url: settings_profile_path, method: :patch, local: true, class: "space-y-5 px-6 py-5" do |f| %>
            <div>
              <label class="mb-2 block text-sm font-medium text-zinc-400">Отображаемое имя</label>
              <%= f.text_field :name, class: "w-full max-w-md rounded-xl border border-zinc-800 bg-black px-4 py-3 text-sm text-white outline-none focus:border-indigo-500" %>
            </div>

            <% if @user.respond_to?(:bio) %>
              <div>
                <label class="mb-2 block text-sm font-medium text-zinc-400">Bio</label>
                <%= f.text_area :bio, rows: 4, class: "w-full max-w-md rounded-xl border border-zinc-800 bg-black px-4 py-3 text-sm text-white outline-none focus:border-indigo-500" %>
              </div>
            <% end %>

            <div>
              <label class="mb-2 block text-sm font-medium text-zinc-400">Статус</label>
              <%= f.text_field :status, placeholder: "Например: В сети", class: "w-full max-w-md rounded-xl border border-zinc-800 bg-black px-4 py-3 text-sm text-white outline-none focus:border-indigo-500" %>
            </div>

            <div>
              <label class="mb-2 block text-sm font-medium text-zinc-400">Дата рождения</label>
              <%= f.date_field :birthday,
                  class: "w-full max-w-md rounded-xl border border-zinc-800 bg-black px-4 py-3 text-sm text-white outline-none focus:border-indigo-500",
                  style: "color-scheme: dark" %>
            </div>

            <div>
              <label class="mb-2 block text-sm font-medium text-zinc-400">Фото профиля</label>
              <%= f.file_field :avatar, accept: "image/*", class: "block w-full max-w-md rounded-xl border border-zinc-800 bg-black px-4 py-3 text-sm text-zinc-300 file:mr-3 file:rounded-full file:border-0 file:bg-indigo-500 file:px-4 file:py-2 file:text-xs file:font-semibold file:text-white hover:file:bg-indigo-600" %>
            </div>

            <div>
              <label class="mb-2 block text-sm font-medium text-zinc-400">Обложка профиля</label>
              <%= f.file_field :cover_image, accept: "image/*", class: "block w-full max-w-md rounded-xl border border-zinc-800 bg-black px-4 py-3 text-sm text-zinc-300 file:mr-3 file:rounded-full file:border-0 file:bg-indigo-500 file:px-4 file:py-2 file:text-xs file:font-semibold file:text-white hover:file:bg-indigo-600" %>
            </div>

            <button type="submit" class="rounded-full bg-indigo-500 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-600">Сохранить профиль</button>
          <% end %>
        </section>

        <section id="chats" data-settings-nav-target="section" class="rounded-2xl border border-zinc-900 bg-zinc-950">
          <div class="border-b border-zinc-900 px-6 py-4">
            <h2 class="text-lg font-bold text-white">Чаты</h2>
          </div>

          <%= form_with model: @user, url: settings_chats_path, method: :patch, local: true, class: "space-y-5 px-6 py-5" do |f| %>
            <div>
              <label class="mb-2 block text-sm font-medium text-zinc-400">Отправка сообщений</label>
              <%= f.select :message_send_shortcut,
                  [["Enter отправляет", "enter"], ["Ctrl+Enter отправляет", "ctrl_enter"]],
                  {},
                  class: "w-full max-w-md rounded-xl border border-zinc-800 bg-black px-4 py-3 text-sm text-white outline-none focus:border-indigo-500" %>
              <p class="mt-2 text-xs text-zinc-500">Если выбран Enter, новая строка делается через Ctrl + Enter. Если выбран Ctrl + Enter, новая строка делается обычным Enter.</p>
            </div>

            <button type="submit" class="rounded-full bg-indigo-500 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-600">Сохранить чаты</button>
          <% end %>
        </section>

        <section id="security" data-settings-nav-target="section" class="rounded-2xl border border-zinc-900 bg-zinc-950 px-6 py-5">
          <h2 class="text-lg font-bold text-white">Безопасность</h2>
          <p class="mt-2 text-sm text-zinc-500">Смену пароля можно сделать через восстановление доступа.</p>
          <div class="mt-4">
            <%= link_to "Перейти к смене пароля", settings_password_reset_path, class: "inline-flex rounded-full border border-zinc-700 px-5 py-2.5 text-sm font-medium text-zinc-200 transition hover:border-indigo-500 hover:text-white" %>
          </div>
        </section>
      </div>
    </section>
  </main>

  <aside class="h-screen overflow-y-auto bg-black p-5">
    <div class="rounded-2xl border border-zinc-900 bg-zinc-950 p-5">
      <h3 class="mb-3 text-base font-semibold text-white">Подсказка</h3>
      <p class="text-sm text-zinc-500">Внутренний сайдбар слева помогает быстро переключаться между разделами настроек.</p>
    </div>
  </aside>
</div>

