<div class="fixed inset-0 mx-auto grid h-screen w-full max-w-[1400px] grid-cols-[280px_1fr_320px] overflow-hidden bg-black text-white">
  <%= render "layouts/main_sidebar", active_tab: :index %>

  <main class="h-screen overflow-y-auto border-r border-zinc-900 bg-black">
    <div class="sticky top-0 z-30 border-b border-zinc-900 bg-black/95 px-6 py-4 backdrop-blur">
      <h1 class="text-[22px] font-bold text-white">Пост</h1>
    </div>

    <section id="feed">
      <% if @posts.any? %>
        <%= render @posts %>
      <% else %>
        <div class="px-5 py-16 text-center text-zinc-500">
          <h3 class="mb-2 text-lg font-semibold text-white">Пост не найден</h3>
        </div>
      <% end %>
    </section>
  </main>

  <aside class="h-screen overflow-y-auto bg-black p-5">
    <%= form_with url: root_path, method: :get, local: true, data: { turbo: false } do %>
      <div class="relative">
        <svg class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <%= text_field_tag :q, nil, placeholder: "Поиск по постам...", class: "w-full rounded-full border border-zinc-900 bg-zinc-950 py-3 pl-12 pr-5 text-[15px] text-white outline-none transition placeholder:text-zinc-500 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/20" %>
      </div>
    <% end %>

    <div class="mt-6 rounded-2xl border border-zinc-900 bg-zinc-950 p-5">
      <h3 class="mb-4 text-lg font-semibold text-white">Актуальное</h3>
      <% [["#Ycom", "Новая версия"], ["#Design", "Минимализм"], ["#AI", "Y-Core"]].each do |tag, title| %>
        <%= link_to root_path(q: tag), class: "mt-4 block group" do %>
          <span class="text-sm text-zinc-500"><%= tag %></span>
          <div class="mt-1 font-semibold text-white transition group-hover:text-indigo-500"><%= title %></div>
        <% end %>
      <% end %>
    </div>
  </aside>
</div>
