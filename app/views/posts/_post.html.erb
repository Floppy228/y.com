<article class="border-b border-zinc-900 px-6 py-5 hover:bg-zinc-950 transition">
  <div class="flex gap-3">

    <div class="h-10 w-10 shrink-0 rounded-full bg-gradient-to-br from-indigo-500 to-purple-950 flex items-center justify-center text-sm font-bold text-white">
      <%= post.user.name.first.upcase %>
    </div>

    <div class="flex-1 min-w-0">

      <div class="flex items-center gap-2">
        <span class="font-semibold text-white"><%= post.user.name %></span>
        <span class="text-zinc-500 text-sm">@<%= post.user.username %></span>
        <span class="text-zinc-600 text-sm">·</span>
        <span class="text-zinc-500 text-sm"><%= time_ago_in_words(post.created_at) %> назад</span>
      </div>

      <% if post.content.present? %>
        <p class="mt-1 text-[15px] leading-relaxed text-zinc-100 whitespace-pre-wrap">
          <%= post.content %>
        </p>
      <% end %>

      <% if post.image.attached? %>
        <div class="mt-3 overflow-hidden rounded-xl border border-zinc-800">
          <%= image_tag post.image, class: "w-full cursor-pointer object-cover hover:opacity-90 transition", onclick: "openImageModal(this.src)" %>
        </div>
      <% end %>
    </div>
  </div>
</article>