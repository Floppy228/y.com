<% liked = defined?(current_user) && current_user&.likes&.exists?(post_id: post.id) %>

<article id="post_<%= post.id %>" class="border-b border-zinc-900 px-6 py-5 hover:bg-zinc-950 transition" data-post-id="<%= post.id %>">
  <div class="flex gap-3">

    <div class="h-10 w-10 shrink-0 overflow-hidden rounded-full bg-gradient-to-br from-indigo-500 to-purple-950 flex items-center justify-center text-sm font-bold text-white">
      <% if post.user.avatar.attached? %>
        <%= image_tag post.user.avatar, class: "h-full w-full object-cover" %>
      <% else %>
        <%= post.user.name.first.upcase %>
      <% end %>
    </div>

    <div class="flex-1 min-w-0">

      <div class="flex items-center gap-2">
        <%= link_to user_path(post.user), class: "font-semibold text-white hover:underline" do %>
          <%= post.user.name %>
        <% end %>
        <%= link_to user_path(post.user), class: "text-zinc-500 text-sm hover:underline" do %>
          @<%= post.user.username %>
        <% end %>
        <span class="text-zinc-600 text-sm">·</span>
        <span class="text-zinc-500 text-sm"><%= time_ago_in_words(post.created_at) %> назад</span>
      </div>

      <% if post.content.present? %>
        <p class="mt-1 text-[15px] leading-relaxed text-zinc-100 whitespace-pre-wrap">
          <%= post.content %>
        </p>
      <% end %>

      <% if post.image.attached? %>
        <div class="mt-3 overflow-hidden rounded-xl border border-zinc-800">
          <%= image_tag post.image, class: "w-full cursor-pointer object-cover hover:opacity-90 transition", onclick: "openImageModal(this.src)" %>
        </div>
      <% end %>

      <!-- Actions -->
      <div class="mt-3 flex items-center gap-6">
        <!-- Like -->
        <%= form_with url: liked ? unlike_post_path(post) : like_post_path(post), method: liked ? :delete : :post, class: "inline", data: { turbo_stream: true } do %>
          <button type="submit" class="flex items-center gap-1.5 text-sm transition <%= liked ? 'text-red-500' : 'text-zinc-500 hover:text-red-500' %>">
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="<%= liked ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <span><%= post.likes_count %></span>
          </button>
        <% end %>

        <!-- Comment -->
        <button type="button" class="flex items-center gap-1.5 text-sm text-zinc-500 hover:text-indigo-500 transition" onclick="toggleComments(this, <%= post.id %>)">
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          <span><%= post.comments_count %></span>
        </button>

        <!-- Share -->
        <button type="button" class="flex items-center gap-1.5 text-sm text-zinc-500 hover:text-indigo-500 transition" onclick="openShareModal(this, <%= post.id %>)">
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
            <polyline points="16 6 12 2 8 6"/>
            <line x1="12" y1="2" x2="12" y2="15"/>
          </svg>
          <span><%= post.shares_count %></span>
        </button>
      </div>

      <!-- Comments section (hidden by default) -->
      <div class="mt-3 hidden" data-comments-container="<%= post.id %>">
        <div class="space-y-3 border-l-2 border-zinc-800 pl-4">
          <% post.comments.includes(:user).each do |comment| %>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-white"><%= comment.user.name %></span>
                <span class="text-xs text-zinc-500">@<%= comment.user.username %></span>
              </div>
              <p class="mt-0.5 text-sm text-zinc-300"><%= comment.content %></p>
            </div>
          <% end %>
        </div>

        <%= form_with url: post_comments_path(post), method: :post, local: true, class: "mt-3 flex gap-2" do %>
          <%= text_field_tag "comment[content]", nil, placeholder: "Написать комментарий...", class: "flex-1 rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-2 text-sm text-white outline-none placeholder:text-zinc-600 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/20" %>
          <%= submit_tag "→", class: "rounded-xl bg-indigo-500 px-4 py-2 text-sm font-bold text-white transition hover:bg-indigo-600" %>
        <% end %>
      </div>
    </div>
  </div>
</article>